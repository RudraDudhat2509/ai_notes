response = client.messages.create(
    model="claude-sonnet-4-6",
    max_tokens=1024,
    system=[
        {
            "type": "text",
            "text": "You are an expert at analyzing financial documents.",
            "cache_control": {"type": "ephemeral"}  # cache this prefix
        }
    ],
    messages=[{"role": "user", "content": f"Analyze: {document}"}]
)

# Check cache performance:
print(f"Cached tokens:  {response.usage.cache_read_input_tokens}")   # paid 10%
print(f"New tokens:     {response.usage.cache_creation_input_tokens}") # paid 100%

